      "response": []
    },
    {
      "name": "US-002: Token Refresh",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Refresh token exists in env\", function () {\r",
              "  const rt = pm.environment.get(\"refresh_token\");\r",
              "  pm.expect(rt, \"refresh_token is empty/missing\").to.be.ok;\r",
              "  pm.expect(rt).to.not.equal(\"refresh_token\");\r",
              "});\r",
              "\r",
              "pm.test(\"New access token returned\", function () {\r",
              "  pm.response.to.have.status(200);\r",
              "  const json = pm.response.json();\r",
              "  pm.expect(json).to.have.property(\"access_token\");\r",
              "\r",
              "  // Save new tokens (handle rotation)\r",
              "  pm.environment.set(\"access_token\", json.access_token);\r",
              "  if (json.refresh_token) pm.environment.set(\"refresh_token\", json.refresh_token);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
