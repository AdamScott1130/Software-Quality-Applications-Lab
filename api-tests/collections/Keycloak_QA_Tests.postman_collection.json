{
  "info": {
    "_postman_id": "87667c02-1982-4028-9bdf-93cde5952a44",
    "name": "Keycloak _QA_Tests",
    "description": "API automation tests for Keycloak IAM system covering login, token management, role assignment, session tracking, and data validation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "39434105"
  },
  "item": [
    {
      "name": "US-001: User Authentication - Get Access Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Access token received\", function () {\r",
              "  pm.response.to.have.status(200);\r",
              "  const json = pm.response.json();\r",
              "  pm.expect(json).to.have.property(\"access_token\");\r",
              "  pm.expect(json).to.have.property(\"refresh_token\"); // important\r",
              "});\r",
              "\r",
              "// store for next requests\r",
              "const json = pm.response.json();\r",
              "pm.environment.set(\"access_token\", json.access_token);\r",
              "pm.environment.set(\"refresh_token\", json.refresh_token);\r",
              "\r",
              "console.log(\"Saved refresh_token (first 20 chars):\", (json.refresh_token || \"\").slice(0, 20));"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "client_id",
              "value": "{{client_id}}",
              "type": "text",
              "uuid": "aec7318f-5458-4cf7-9ae5-7e5054325d2a"
            },
