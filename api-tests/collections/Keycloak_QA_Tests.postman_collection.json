    {
      "name": "API-03: Refresh token returns new access token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const rt = pm.environment.get(\"refresh_token\");\r",
              "const json = pm.response.json();\r",
              "pm.test(\"POST request to /realms/master/protocol/openid-connect/token returns status code 200 OK\", function () {\r",
              "  pm.response.to.have.status(200);\r",
              "  });\r",
              "pm.test(\"Refresh token from previous request stored as an environment variable is not empty or missing\", function () {\r",
              "  pm.expect(rt, \"refresh_token is empty/missing\").to.be.ok;\r",
              "});\r",
              "\r",
              "pm.test(\"New refresh token is not the same as the old one\", function () {\r",
              "  pm.expect(rt).to.not.equal(\"refresh_token\");\r",
              "});\r",
              "\r",
              "pm.test(\"New access token returned\", function () {\r",
              "  pm.expect(json).to.have.property(\"access_token\");\r",
              "\r",
              "  // Save new tokens (handle rotation)\r",
              "  pm.environment.set(\"access_token\", json.access_token);\r",
              "  if (json.refresh_token) pm.environment.set(\"refresh_token\", json.refresh_token);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "refresh_token",
              "type": "text",
              "uuid": "36854ec7-47f1-4250-8097-30bd63e33a91"
            },
            {
              "key": "client_id",
              "value": "{{client_id}}",
              "type": "text",
              "uuid": "9768ebf0-1d4f-45ed-b3b7-f14c76184065"
            },
            {
              "key": "refresh_token",
              "value": "{{refresh_token}}",
              "type": "text",
              "uuid": "4665009b-ba00-4e37-b0b3-247e72eebe17"
            }
          ]
        },
