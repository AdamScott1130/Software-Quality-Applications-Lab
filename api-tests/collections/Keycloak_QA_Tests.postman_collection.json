  "item": [
    {
      "name": "API-01: Get access token with valid admin credentials",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();\r",
              "pm.test(\"POST request to /realms/master/protocol/openid-connect/token returns status code 200 OK\", function () {\r",
              "  pm.response.to.have.status(200);\r",
              "  });\r",
              "pm.test(\"JSON response body has property 'access_token'\", function () {\r",
              "    pm.expect(json).to.have.property(\"access_token\");\r",
              "  });\r",
              "pm.test(\"JSON response body has property 'refresh_token'\", function () {\r",
              "    pm.expect(json).to.have.property(\"refresh_token\"); // important\r",
              "  });\r",
              "\r",
              "// store for next requests\r",
              "pm.environment.set(\"access_token\", json.access_token);\r",
              "pm.environment.set(\"refresh_token\", json.refresh_token);\r",
              "\r",
              "console.log(\"Saved refresh_token (first 20 chars):\", (json.refresh_token || \"\").slice(0, 20));"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
