          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();\r",
              "pm.test(\"POST request to /realms/master/protocol/openid-connect/token returns status code 400 Bad Request\", function () {\r",
              "  pm.response.to.have.status(400);\r",
              "  });\r",
              "\r",
              "pm.test(\"JSON response body has property 'error'\", function () {\r",
              "    pm.expect(json).to.have.property(\"error\");\r",
              "  });\r",
              "pm.test(\"JSON response body has property 'error_description'\", function () {\r",
              "    pm.expect(json).to.have.property(\"error_description\"); \r",
              "  });\r",
              "pm.test(\"JSON response property 'error' contains correct value\", function () {\r",
              "    pm.expect(json.error).to.contain(\"invalid_grant\");\r",
              "  });\r",
              "pm.test(\"JSON response property 'error_description' contains correct value\", function () {\r",
              "    pm.expect(json.error_description).to.contain(\"Invalid refresh token\"); \r",
              "  });\r",
              "pm.test(\"JSON response body does not have property 'refresh_token'\", function () {\r",
              "    pm.expect(json).to.not.have.property(\"refresh_token\");\r",
              "  });  \r",
              "  pm.test(\"JSON response body does not have property 'access_token'\", function () {\r",
              "    pm.expect(json).to.not.have.property(\"access_token\");\r",
